# ------------------------------------------------------------------
# Tudo aqui também pode ser mudado pelo PAINEL (http://127.0.0.1:9393).
# O que você salva no painel fica em server/private/settings.json e
# vale mais do que este arquivo. Copie para ".env" só se preferir editar à mão.
# ------------------------------------------------------------------

# Usuário do TikTok (sem @) cuja live será monitorada
TIKTOK_USERNAME=seu_usuario
# Porta do servidor (o Godot conecta em ws://127.0.0.1:PORT/ws/godot)
PORT=9393

# Nome do personagem na fala da IA (deixe vazio para não citar nome)
CHARACTER_NAME=

# ============================ IA (respostas) ============================
#   ollama : IA local e grátis (precisa do Ollama instalado)
#   openai : API da OpenAI, ou qualquer uma compatível (Groq, OpenRouter, DeepSeek, LM Studio...)
#   gemini : API do Google Gemini (tem plano grátis)
AI_PROVIDER=ollama
AI_TEMPERATURE=0.7

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
# Contexto fixo (o prompt do personagem tem ~2900 tokens; não mude durante a live)
OLLAMA_NUM_CTX=8192

# --- OpenAI / compatíveis (a mesma chave serve para a voz da OpenAI) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Gemini (a mesma chave serve para a voz do Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tamanho da resposta: curta (~1 frase, mais rápida) | normal (até 2 frases)
REPLY_LENGTH=curta

# ============================ VOZ ============================
#   sapi       : voz do Windows (offline, rápida, não clona). Funciona sem instalar nada.
#   openai     : voz da OpenAI (API)
#   gemini     : voz do Gemini (API)
#   elevenlabs : ElevenLabs (API, aceita voz clonada sua)
#   xtts       : clona a sua voz, local; licença Coqui (NÃO comercial)
#   chatterbox : clona a sua voz, local; licença MIT (muito lento sem placa NVIDIA)
TTS_PROVIDER=sapi

SAPI_VOICE=Maria

OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova

GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- vozes locais clonadas (xtts / chatterbox) ---
# WAV de referência (6 a 30 s da voz). Veja docs/VOZ-LOCAL.md
VOICE_REFERENCE_WAV=assets/voice/default.wav
# Inicia o servidor de voz junto com o painel (0 = você inicia manualmente)
VOICE_AUTOSTART=1
XTTS_URL=http://127.0.0.1:8020
CHATTERBOX_URL=http://127.0.0.1:8021
# Aceite da Coqui Public Model License (obrigatório para TTS_PROVIDER=xtts)
COQUI_TOS_AGREED=0

# Maior pausa (s) aceita entre as frases: 0 = sem pausas | 6 = padrão | 999 = toca cada frase assim que sai
# Com voz por API (rápida) pode usar 999.
SPEECH_MAX_GAP_SECONDS=6

# Proxy opcional para o TikTok (ex: socks5h://127.0.0.1:9050 para Tor)
TIKTOK_PROXY=
